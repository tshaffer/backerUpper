{
  "name": "backerupper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/server/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "5.2.1",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "^8.3.6"
  }
}
