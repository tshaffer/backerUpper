{
  "tools": {
    "rsync": "/opt/homebrew/bin/rsync",
    "mongodump": "/opt/homebrew/bin/mongodump"
  },
  "excludes": ["._*", ".DS_Store"],
  "guard": { "replacedPercent": 5, "replacedMinFiles": 20 },
  "freeSpaceMarginMB": 1024,
  "volumes": [
    { "id": "shmedia", "label": "ShMedia", "uuid": "7522B9AB-772B-3266-A946-4BA89FBEF18C" },
    { "id": "shafferoto", "label": "SHAFFEROTO", "uuid": "A024F39A-2948-361E-9123-37AF9C2BED6B" }
  ],
  "apps": [
    {
      "id": "tedography",
      "name": "Tedography",
      "items": [
        {
          "id": "db", "type": "mongo", "label": "Database", "defaultSelected": true,
          "envFile": "~/src/tedography/apps/api/.env", "envKey": "TEDOGRAPHY_MONGODB_URI",
          "database": "tedography", "root": "AtlasDBBackups",
          "destinations": ["shmedia", "shafferoto"], "retention": 10
        },
        { "id": "media", "type": "files", "label": "Media", "note": "Originals", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/Media", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/Media", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "unrotated", "type": "files", "label": "Unrotated", "note": "Pre-rotation originals", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/Unrotated", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/Unrotated", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "edit", "type": "files", "label": "Edit", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/Edit", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/Edit", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "scans", "type": "files", "label": "Scans", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/Scans", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/Scans", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "printOrders", "type": "files", "label": "printOrders", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/printOrders", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/printOrders", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "exports", "type": "files", "label": "Exports", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/Exports", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/Exports", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "workspace", "type": "files", "label": "Workspace", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/Workspace", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/Workspace", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "editWorkspace", "type": "files", "label": "EditWorkspace", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/EditWorkspace", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/EditWorkspace", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "aiQueue", "type": "files", "label": "AI-Queue", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/AI-Queue", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/AI-Queue", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "aiTests", "type": "files", "label": "AI-Tests", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/AI-Tests", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/AI-Tests", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "chattyGenerated", "type": "files", "label": "ChattyGenerated", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/ChattyGenerated", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/ChattyGenerated", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "importStaging", "type": "files", "label": "ImportStaging", "defaultSelected": true, "sourceVolume": "shmedia", "sourcePath": "Tedography/ImportStaging", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/ImportStaging", "replacedRoot": "TedographyBackups/_replaced" },
        { "id": "derived", "type": "files", "label": "Derived", "note": "Can be rebuilt by Tedography", "defaultSelected": false, "sourceVolume": "shmedia", "sourcePath": "Tedography/Derived", "destVolumes": ["shafferoto"], "destPath": "TedographyBackups/Derived", "replacedRoot": "TedographyBackups/_replaced" }
      ]
    },
    {
      "id": "chatorama",
      "name": "Chatorama",
      "items": [
        {
          "id": "db", "type": "mongo", "label": "Database", "defaultSelected": true,
          "envFile": "~/Documents/Projects/chatorama/packages/chatalog/backend/.env", "envKey": "MONGO_URI",
          "database": "chatalog_dev", "root": "AtlasDBBackups",
          "destinations": ["shmedia", "shafferoto"], "retention": 10
        },
        { "id": "assets", "type": "files", "label": "Assets", "note": "Uploaded images and PDFs", "defaultSelected": true, "sourcePath": "~/Documents/Projects/chatorama/packages/chatalog/backend/storage/assets", "destVolumes": ["shmedia", "shafferoto"], "destPath": "ChatoramaBackups/assets", "replacedRoot": "ChatoramaBackups/_replaced" },
        { "id": "data", "type": "files", "label": "Data", "note": "AI seed, classification and audit files", "defaultSelected": true, "sourcePath": "~/Documents/Projects/chatorama/packages/chatalog/backend/data", "destVolumes": ["shmedia", "shafferoto"], "destPath": "ChatoramaBackups/data", "replacedRoot": "ChatoramaBackups/_replaced" },
        { "id": "chatgptExports", "type": "files", "label": "ChatGPT exports", "defaultSelected": true, "sourcePath": "~/Documents/ChatGPTExports", "destVolumes": ["shmedia", "shafferoto"], "destPath": "ChatoramaBackups/ChatGPTExports", "replacedRoot": "ChatoramaBackups/_replaced" },
        { "id": "inbox", "type": "files", "label": "Import inbox", "defaultSelected": true, "sourcePath": "~/Documents/chatalogInbox", "destVolumes": ["shmedia", "shafferoto"], "destPath": "ChatoramaBackups/chatalogInbox", "replacedRoot": "ChatoramaBackups/_replaced" },
        { "id": "scripts", "type": "files", "label": "Scripts", "defaultSelected": true, "sourcePath": "~/Documents/chatalogScripts", "destVolumes": ["shmedia", "shafferoto"], "destPath": "ChatoramaBackups/chatalogScripts", "replacedRoot": "ChatoramaBackups/_replaced" }
      ]
    }
  ]
}
